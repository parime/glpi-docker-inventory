{# Onglet « Registres maîtrisés » de la page de configuration du plugin (#35) : d'où les images
   déployées doivent venir. #}
<div class="container-fluid">
    {{ include('@dockerinventory/_page_help.html.twig', {
        page: 'registries',
        purpose: __(
            'Une image qui ne vient pas d’un registre maîtrisé n’est ni analysée ni contrôlée.',
            'dockerinventory'
        ),
        expected: __('Indiquez les hôtes de vos registres, un par ligne, puis enregistrez.', 'dockerinventory'),
    }) }}
    {{ include('@dockerinventory/_section_nav.html.twig') }}
    <div class="card mb-3" id="managed-registries">
        <div class="card-header d-flex flex-wrap align-items-center gap-2">
            <h2 class="card-title mb-0">
                <i class="ti ti-building-warehouse me-2" aria-hidden="true"></i>
                {{ __('Registres maîtrisés', 'dockerinventory') }}
            </h2>
            <span class="text-muted small">
                {{ __('Images déployées hors de ces registres : signalées.', 'dockerinventory') }}
            </span>
        </div>
        <div class="card-body">
            <p class="text-muted">
                {{ __(
                    'Une image qui ne vient pas d’un registre maîtrisé n’est ni analysée ni contrôlée.',
                    'dockerinventory'
                ) }}
                {{ __(
                    'Elle est signalée dans l’onglet « Images Harbor et vulnérabilités » et sur la fiche du service.',
                    'dockerinventory'
                ) }}
            </p>
            <form method="post" action="{{ page_url }}">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <label class="form-label" for="managed-registries-text">
                    {{ __('Hôtes des registres maîtrisés, un par ligne', 'dockerinventory') }}
                </label>
                <textarea name="managed_registries" id="managed-registries-text" class="form-control mb-2" rows="3"
                          placeholder="registry.exemple.test:5000">{{ text }}</textarea>
                <div class="form-text mb-3">
                    {{ __(
                   'Tel qu’écrit au début des images (registry.exemple.test:5000/outils/wiki). docker.io : Docker Hub.',
                        'dockerinventory'
                    ) }}
                    {{ __('Laisser vide pour utiliser les hôtes des connexions Harbor :', 'dockerinventory') }}
                    {% for host in harbor_hosts %}
                        <code class="me-1">{{ host }}</code>
                    {% else %}
                        <em>{{ __('aucune connexion Harbor', 'dockerinventory') }}</em>
                    {% endfor %}
                </div>
                <button type="submit" name="save_managed_registries" value="1" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1" aria-hidden="true"></i>
                    {{ __('Enregistrer', 'dockerinventory') }}
                </button>
            </form>
        </div>
    </div>
</div>
