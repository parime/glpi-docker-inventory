{# Tableau des versions (ImageVersion::present()). `containers_mode` : conteneurs sans service
   (colonne du conteneur et de la raison au lieu du service et de l'application). #}
{% set containers_mode = containers_mode|default(false) %}
{% set hide_appliance = hide_appliance|default(false) %}
{% set eol_enabled = eol_enabled|default(false) %}
{% set registry_title = __('Page du registre', 'dockerinventory') %}
<table class="table table-hover table-sm card-table align-middle">
    <thead>
        <tr>
            {% if containers_mode %}
                <th>{{ __('Conteneur WUD', 'dockerinventory') }}</th>
                <th>{{ __('Pourquoi sans service', 'dockerinventory') }}</th>
            {% else %}
                <th>{{ __('Service', 'dockerinventory') }}</th>
                {% if not hide_appliance %}
                    <th>{{ __('Application et environnement', 'dockerinventory') }}</th>
                {% endif %}
            {% endif %}
            <th>{{ __('Image', 'dockerinventory') }}</th>
            <th>{{ __('Version déployée', 'dockerinventory') }}</th>
            <th>{{ __('Dernière version', 'dockerinventory') }}</th>
            <th>{{ __('Écart', 'dockerinventory') }}</th>
            {% if eol_enabled %}
                <th>{{ __('Fin de support', 'dockerinventory') }}</th>
            {% endif %}
            <th>{{ __('Vérifié le', 'dockerinventory') }}</th>
        </tr>
    </thead>
    <tbody>
        {% for row in rows %}
            <tr>
                {% if containers_mode %}
                    <td>
                        {% for name in row.containers %}
                            <div><i class="ti ti-box me-1 text-muted" aria-hidden="true"></i>{{ name }}</div>
                        {% endfor %}
                        <div class="small text-muted">{{ row.connection_name }}</div>
                    </td>
                    <td class="small">{{ row.match }}</td>
                {% else %}
                    <td>
                        {% if row.service %}
                            <a href="{{ row.service.url }}">
                                <i class="ti ti-brand-docker me-1" aria-hidden="true"></i>{{ row.service.name }}
                            </a>
                            {% if row.service.is_retired %}
                                <span class="badge bg-secondary text-white ms-1">
                                {{ __('Retiré', 'dockerinventory') }}</span>
                            {% endif %}
                        {% endif %}
                        {% if row.stack_name %}
                            <div class="small text-muted">
                            {{ __('Stack', 'dockerinventory') }} : {{ row.stack_name }}</div>
                        {% endif %}
                    </td>
                    {% if not hide_appliance %}
                    <td>
                        {% if row.appliance %}
                            {% if row.appliance.url %}
                                <a href="{{ row.appliance.url }}">
                                    <i class="ti ti-apps me-1" aria-hidden="true"></i>{{ row.appliance.name }}
                                </a>
                            {% else %}
                                {{ row.appliance.name }}
                            {% endif %}
                        {% else %}
                            <span class="text-muted">-</span>
                        {% endif %}
                        {% if row.environment %}
                            <div><span class="badge bg-azure-lt">{{ row.environment }}</span></div>
                        {% endif %}
                    </td>
                    {% endif %}
                {% endif %}
                <td>
                    <span class="text-break">{{ row.image ?: '-' }}</span>
                    {% if row.registry_link %}
                        <a href="{{ row.registry_link }}" target="_blank" rel="noopener noreferrer"
                           title="{{ registry_title }}" aria-label="{{ registry_title }}" data-bs-toggle="tooltip">
                            <i class="ti ti-external-link" aria-hidden="true"></i>
                        </a>
                    {% elseif row.registry_name and row.registry_name != 'hub' %}
                        <div class="small text-muted">
                            {{ __('Registre', 'dockerinventory') }} : {{ row.registry_name }}
                        </div>
                    {% endif %}
                </td>
                <td>
                    <span class="badge bg-blue-lt">{{ row.deployed_tag ?: '-' }}</span>
                    {% if row.deployed_short %}
                        <div><code class="small" title="{{ row.deployed_digest }}">{{ row.deployed_short }}</code></div>
                    {% endif %}
                    {% if row.is_out_of_sync %}
                        <div>
                            <span class="badge bg-warning text-white" title="{{ row.deployed_versions }}"
                                  data-bs-toggle="tooltip">
                                <i class="ti ti-arrows-split me-1" aria-hidden="true"></i>
                                {{ __('Réplicas désynchronisés', 'dockerinventory') }}
                            </span>
                        </div>
                    {% endif %}
                </td>
                <td>
                    <span class="badge bg-green-lt">{{ row.latest_tag ?: '-' }}</span>
                    {% if row.digest_changed %}
                        <div><code class="small" title="{{ row.latest_digest }}">{{ row.latest_short }}</code></div>
                    {% endif %}
                </td>
                <td>
                    {{ include('@dockerinventory/_version_badge.html.twig', {gap: row.gap}) }}
                    {% if row.gap_code == 'untrackable' and row.update_available %}
                        <div class="small text-muted mt-1">
                        {{ __('Nouvelle empreinte disponible', 'dockerinventory') }}</div>
                    {% endif %}
                    {% if row.error and row.source_code == 'registry' %}
                        <div class="small text-warning mt-1">
                            <i class="ti ti-info-circle me-1" aria-hidden="true"></i>{{ row.error }}
                        </div>
                    {% elseif row.error %}
                        <div class="small text-danger mt-1" title="{{ row.error }}">
                            <i class="ti ti-alert-circle me-1" aria-hidden="true"></i>
                            {{ __('Erreur WUD', 'dockerinventory') }}
                        </div>
                    {% endif %}
                </td>
                {% if eol_enabled %}
                    <td>{{ include('@dockerinventory/_eol_badge.html.twig', {eol: row.eol}) }}</td>
                {% endif %}
                <td class="text-nowrap small">
                    {{ row.date_checked|formatted_datetime }}
                    <div class="text-muted">{{ row.source }}</div>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
