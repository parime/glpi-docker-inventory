{# Onglet « Services » d'une application : services Swarm ou Compose de la stack correspondante. #}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ti ti-brand-docker me-2" aria-hidden="true"></i>
            {{ __('Services Docker de cette stack', 'dockerinventory') }}
        </h3>
    </div>
    {% if services is empty %}
        <div class="card-body">
            <p class="text-muted mb-0">
                {{ __('Aucun service importé pour cette application.', 'dockerinventory') }}
                {{ __("Elle n'est peut-être liée à aucune stack Portainer.", 'dockerinventory') }}
            </p>
        </div>
    {% else %}
        <div class="table-responsive">
            {{ include('@dockerinventory/_service_rows.html.twig', {services: services}) }}
        </div>
        <div class="card-footer text-muted small">
            {{ __('Données importées de Portainer en lecture seule.', 'dockerinventory') }}
            {{ __('Un service disparu est marqué « Retiré », jamais supprimé.', 'dockerinventory') }}
        </div>
    {% endif %}
</div>
