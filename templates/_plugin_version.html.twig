{% import '@dockerinventory/_tone.html.twig' as tone %}

{# Encadré « Version du plugin » (charte section 9 bis, parime/glpi-plugin-template#12 ; #121), en
   tête de la page de configuration : version installée, dernière version publiée sur GitHub, raison
   quand elle est inconnue, et réglage de la vérification. Variables : plugin_version (tableau de
   PluginVersion::status()), version_check (vérification activée), page_url. #}
{% set pv = plugin_version %}
{% set reasons = {
    'disabled': __('la vérification est désactivée ci-dessous', 'dockerinventory'),
    'unreachable': __(
        'GitHub est injoignable depuis le serveur GLPI (pas d’accès à Internet, proxy ou pare-feu)',
        'dockerinventory'
    ),
    'rate_limited': __(
        'la limite de requêtes de GitHub est atteinte, nouvel essai dans une heure au plus',
        'dockerinventory'
    ),
    'timeout': __('GitHub n’a pas répondu dans les 3 secondes', 'dockerinventory'),
    'no_release': __('aucune version n’est encore publiée sur GitHub', 'dockerinventory'),
    'invalid_response': __('la réponse de GitHub n’a pas pu être lue', 'dockerinventory'),
} %}
<div class="card card-sm mb-3" id="dockerinventory-plugin-version">
    <div class="card-body d-flex align-items-start gap-3">
        <i class="ti ti-brand-github fs-1 text-muted" aria-hidden="true"></i>
        <div class="flex-fill">
            <h2 class="h4 mb-1">{{ __('Version du plugin', 'dockerinventory') }}</h2>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="text-muted small">{{ __('Version installée', 'dockerinventory') }}</span>
                <span class="badge {{ tone.badge('info') }}">
                    <i class="ti ti-package me-1" aria-hidden="true"></i>v{{ pv.installed }}
                </span>
                {% if pv.latest %}
                    <span class="text-muted small">{{ __('Dernière version sur GitHub', 'dockerinventory') }}</span>
                    <span class="badge {{ tone.badge('secondary') }}">
                        <i class="ti ti-tag me-1" aria-hidden="true"></i>v{{ pv.latest }}
                    </span>
                {% endif %}
                {% if pv.state == 'up_to_date' %}
                    <span class="badge {{ tone.badge('success') }}">
                        <i class="ti ti-circle-check me-1" aria-hidden="true"></i>
                        {{- __('À jour', 'dockerinventory') -}}
                    </span>
                {% elseif pv.state == 'update_available' %}
                    <span class="badge {{ tone.badge('warning') }}">
                        <i class="ti ti-arrow-up-circle me-1" aria-hidden="true"></i>
                        {{- __('Mise à jour disponible : %s', 'dockerinventory')|format('v' ~ pv.latest) -}}
                    </span>
                {% else %}
                    <span class="badge {{ tone.badge('secondary') }}">
                        <i class="ti ti-help-circle me-1" aria-hidden="true"></i>
                        {{- __('Dernière version inconnue', 'dockerinventory') -}}
                    </span>
                {% endif %}
            </div>

            {% if pv.state == 'update_available' %}
                <div class="mt-2 d-flex flex-wrap gap-2">
                    <a href="{{ pv.release_url }}" target="_blank" rel="noopener noreferrer"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="ti ti-notes me-1" aria-hidden="true"></i>{{ __('Notes de version', 'dockerinventory') }}
                    </a>
                    {% if pv.download_url %}
                        <a href="{{ pv.download_url }}" target="_blank" rel="noopener noreferrer"
                           class="btn btn-sm btn-outline-secondary">
                            <i class="ti ti-download me-1" aria-hidden="true"></i>
                            {{- __('Télécharger l’archive', 'dockerinventory') -}}
                        </a>
                    {% endif %}
                </div>
            {% endif %}

            {% if pv.reason %}
                <div class="text-muted small mt-2">
                    <i class="ti ti-info-circle me-1" aria-hidden="true"></i>
                    {% if pv.stale %}
                        {{ __('Dernière vérification en échec : %s.', 'dockerinventory')
                            |format(reasons[pv.reason] ?? pv.reason) }}
                        {{ __('Résultat de la dernière vérification réussie (%s).', 'dockerinventory')
                            |format(pv.last_success|formatted_datetime) }}
                    {% else %}
                        {{ __('Raison : %s.', 'dockerinventory')|format(reasons[pv.reason] ?? pv.reason) }}
                        {% if pv.reason != 'disabled' %}
                            {% if pv.last_success %}
                                {{ __('Dernière vérification réussie : %s.', 'dockerinventory')
                                    |format(pv.last_success|formatted_datetime) }}
                            {% else %}
                                {{ __('Aucune vérification réussie pour le moment.', 'dockerinventory') }}
                            {% endif %}
                        {% endif %}
                    {% endif %}
                    {% if pv.reason != 'disabled' %}
                        <a href="{{ pv.release_url }}" target="_blank" rel="noopener noreferrer"
                           class="text-decoration-underline">
                            {{- __('Voir les versions sur GitHub', 'dockerinventory') -}}
                        </a>
                    {% endif %}
                </div>
            {% elseif pv.checked_at %}
                <div class="text-muted small mt-2">
                    <i class="ti ti-clock me-1" aria-hidden="true"></i>
                    {{ __('Dernière vérification : %s (renouvelée toutes les 12 heures).', 'dockerinventory')
                        |format(pv.checked_at|formatted_datetime) }}
                </div>
            {% endif %}

            <form method="post" action="{{ page_url }}" class="d-flex flex-wrap align-items-center gap-2 mt-2">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <label class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" name="version_check" value="1"
                           id="dockerinventory-version-check" {{ version_check ? 'checked' : '' }}>
                    <span class="form-check-label">
                        {{ __('Vérifier les nouvelles versions sur GitHub', 'dockerinventory') }}
                    </span>
                </label>
                <button type="submit" name="save_version_check" value="1" class="btn btn-outline-primary btn-sm">
                    <i class="ti ti-device-floppy me-1" aria-hidden="true"></i>
                    {{- __('Enregistrer', 'dockerinventory') -}}
                </button>
            </form>
            <div class="form-hint">
                {{ __(
                    'Lit la dernière version publiée sur GitHub toutes les 12 heures au plus, sans rien envoyer de ce GLPI.',
                    'dockerinventory'
                ) }}
                {{ __('À désactiver sur un serveur sans accès à Internet.', 'dockerinventory') }}
            </div>
        </div>
    </div>
</div>
