{# Suivi d'un ticket de fin de support encore ouvert, quand la situation du service change. #}
<p>
    {% if kind == 'resolved' %}
        <strong>{{ __('Branche maintenue', 'dockerinventory') }}</strong> :
        {{ __('le service utilise maintenant', 'dockerinventory') }} {{ product }} {{ cycle }} ({{ status.label }}).
    {% else %}
        <strong>{{ __('Nouvelle situation', 'dockerinventory') }}</strong> :
        {{ product }} {{ cycle }} ({{ status.label }}).
    {% endif %}
    {% if eol and eol != 'yes' %}
        {{ __('Fin de support', 'dockerinventory') }} : {{ eol|formatted_date }}.
    {% endif %}
</p>
<p>
    {{ __('Situation précédente', 'dockerinventory') }} :
    {{ previous.product ?: '-' }} {{ previous.cycle ?: '-' }}
    {% if previous.eol and previous.eol != 'yes' %}({{ previous.eol|formatted_date }}){% endif %}.
</p>
<p>
    {{ __('Suivi ajouté par Inventaire Docker : le statut du ticket n’est pas modifié.', 'dockerinventory') }}
    <a href="{{ service_url }}">{{ __('Voir le service dans GLPI', 'dockerinventory') }}</a>
</p>
