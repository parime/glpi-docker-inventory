{# Description d'un ticket de fin de support (texte enrichi du ticket). #}
<p>
    {{ __('La branche de l’image déployée par ce service arrive en fin de support, ou l’a dépassée.', 'dockerinventory') }}
    {{ __('Elle ne recevra plus de correctifs de sécurité : prévoir le passage à une branche maintenue.', 'dockerinventory') }}
</p>
<ul>
    <li><strong>{{ __('Service', 'dockerinventory') }}</strong> : {{ service }}</li>
    {% if stack %}
        <li><strong>{{ __('Stack', 'dockerinventory') }}</strong> : {{ stack }}</li>
    {% endif %}
    {% if appliance %}
        <li><strong>{{ __('Application', 'dockerinventory') }}</strong> : {{ appliance }}</li>
    {% endif %}
    <li><strong>{{ __('Image', 'dockerinventory') }}</strong> : {{ image }}:{{ tag }}</li>
    <li><strong>{{ __('Branche', 'dockerinventory') }}</strong> : {{ product }} {{ cycle }}</li>
    <li>
        <strong>{{ __('Fin de support', 'dockerinventory') }}</strong> :
        {% if eol == 'yes' %}
            {{ __('atteinte (date non publiée)', 'dockerinventory') }}
        {% else %}
            {{ eol|formatted_date }}
        {% endif %}
        ({{ status.label }})
    </li>
</ul>
<p>
    <a href="{{ service_url }}">{{ __('Voir le service dans GLPI', 'dockerinventory') }}</a>
</p>
<p>
    {{ __('Ticket créé par Inventaire Docker, délai choisi (jours) :', 'dockerinventory') }} {{ threshold }}.
    {{ __(
        'Un suivi sera ajouté si la situation change ; jamais de changement de statut, de priorité ni d’affectation.',
        'dockerinventory'
    ) }}
</p>
