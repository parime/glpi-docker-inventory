{# Page « Fin de support des images » (configuration) : source des cycles de vie, correspondances
   image => produit, images en service sans correspondance. #}
<div class="container-fluid">
    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap align-items-center gap-2">
            <h2 class="card-title mb-0">
                <i class="ti ti-calendar-x me-2" aria-hidden="true"></i>
                {{ __('Fin de support des images', 'dockerinventory') }}
            </h2>
            {% if settings.enabled %}
                <span class="badge bg-success text-white">
                    <i class="ti ti-circle-check me-1" aria-hidden="true"></i>{{ __('Activée', 'dockerinventory') }}
                </span>
            {% else %}
                <span class="badge bg-secondary text-white">
                    <i class="ti ti-circle-off me-1" aria-hidden="true"></i>{{ __('Désactivée', 'dockerinventory') }}
                </span>
            {% endif %}
            <a href="{{ versions_url }}" class="btn btn-outline-secondary btn-sm ms-auto">
                <i class="ti ti-tags me-1" aria-hidden="true"></i>{{ __('Versions des images', 'dockerinventory') }}
            </a>
        </div>
        <div class="card-body">
            <p class="text-muted">
                {{ __(
                    'Une image peut être à jour dans sa branche alors que cette branche ne reçoit plus de correctifs.',
                    'dockerinventory'
                ) }}
                {{ __(
                    'Le plugin compare la branche déployée aux dates de fin de support publiées par une source ouverte.',
                    'dockerinventory'
                ) }}
            </p>
            <div class="alert alert-info">
                <i class="ti ti-world-upload me-2" aria-hidden="true"></i>
                <div>
                    {{ __('Appel sortant, désactivé par défaut : une requête par produit et par jour au plus.', 'dockerinventory') }}
                    {{ __(
                        'Seul le nom du produit est envoyé (postgresql, nodejs...), jamais vos services ni vos hôtes.',
                        'dockerinventory'
                    ) }}
                    <div class="mt-1">
                        {{ __('Source', 'dockerinventory') }} : <code>{{ source_url }}</code>
                        {% if is_default_source %}
                            (<a href="https://endoflife.date" target="_blank" rel="noopener noreferrer">endoflife.date</a>)
                        {% endif %}
                    </div>
                </div>
            </div>
            <form method="post" action="{{ page_url }}" class="row g-3 align-items-end">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <div class="col-sm-6 col-lg-4">
                    <label class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" name="enabled" value="1"
                               id="dockerinventory-lifecycle-enabled" {{ settings.enabled ? 'checked' : '' }}>
                        <span class="form-check-label">
                            {{ __('Lire les cycles de vie (fin de support)', 'dockerinventory') }}
                        </span>
                    </label>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <label class="form-label" for="dockerinventory-warning-days">
                        {{ __('Signaler « bientôt en fin de support » (jours avant)', 'dockerinventory') }}
                    </label>
                    <input type="number" class="form-control" id="dockerinventory-warning-days" name="warning_days"
                           min="0" max="{{ max_days }}" value="{{ settings.warning_days }}">
                </div>
                <div class="col-auto">
                    <button type="submit" name="save_settings" value="1" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-1" aria-hidden="true"></i>{{ __('Enregistrer', 'dockerinventory') }}
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap align-items-center gap-2">
            <h3 class="card-title mb-0">
                <i class="ti ti-refresh me-2" aria-hidden="true"></i>{{ __('Dernière mise à jour', 'dockerinventory') }}
            </h3>
            {% if settings.enabled %}
                <form method="post" action="{{ page_url }}" class="ms-auto">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <button type="submit" name="refresh" value="1" class="btn btn-outline-primary btn-sm"
                            title="{{ __('Chaque produit au plus une fois par jour.', 'dockerinventory') }}"
                            data-bs-toggle="tooltip">
                        <i class="ti ti-refresh me-1" aria-hidden="true"></i>
                        {{ __('Mettre à jour maintenant', 'dockerinventory') }}
                    </button>
                </form>
            {% endif %}
        </div>
        <div class="card-body">
            {% if source.last_success %}
                <p class="mb-2">
                    <i class="ti ti-database me-1 text-muted" aria-hidden="true"></i>
                    {{ __('Données en cache du', 'dockerinventory') }}
                    <strong>{{ source.last_success|formatted_datetime }}</strong>
                    {% if source.last_attempt and source.last_attempt != source.last_success %}
                        <span class="text-muted">
                            ({{ __('dernier essai', 'dockerinventory') }} : {{ source.last_attempt|formatted_datetime }})
                        </span>
                    {% endif %}
                </p>
            {% else %}
                <p class="text-muted mb-2">
                    {{ __('Aucune donnée pour le moment.', 'dockerinventory') }}
                    {% if settings.enabled %}
                        {{ __(
                            'Cliquez sur « Mettre à jour maintenant » ou attendez la tâche automatique (une fois par jour).',
                            'dockerinventory'
                        ) }}
                    {% else %}
                        {{ __('Activez la lecture des cycles de vie ci-dessus.', 'dockerinventory') }}
                    {% endif %}
                </p>
            {% endif %}
            {% if source.errors is not empty %}
                <div class="alert alert-warning mb-0">
                    <i class="ti ti-alert-triangle me-2" aria-hidden="true"></i>
                    <div>
                        {{ __('Produits non lus à la dernière mise à jour (les données déjà en cache restent utilisées) :', 'dockerinventory') }}
                        <ul class="mb-0">
                            {% for error in source.errors %}
                                <li>
                                    <strong>{{ error.product }}</strong> : {{ error_labels[error.code]|default(error.code) }}
                                    {% if error.date_success %}
                                        <span class="text-muted">
                                            ({{ __('données du', 'dockerinventory') }} {{ error.date_success|formatted_datetime }})
                                        </span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    {% if unmapped is not empty %}
        <div class="card mb-3 border-warning">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-link-off me-2 text-warning" aria-hidden="true"></i>
                    {{ __('Images en service sans correspondance', 'dockerinventory') }}
                    <span class="badge bg-warning-lt ms-2">{{ unmapped|length }}</span>
                </h3>
            </div>
            <div class="card-body pb-0 text-muted">
                {{ __(
                    'Leur fin de support reste « inconnue » : le plugin ne devine jamais le produit d’une image.',
                    'dockerinventory'
                ) }}
                {{ __('Ajoutez une correspondance pour celles qui ont un cycle de vie publié.', 'dockerinventory') }}
            </div>
            <div class="table-responsive">
                <table class="table table-sm card-table align-middle">
                    <thead>
                        <tr>
                            <th>{{ __('Image', 'dockerinventory') }}</th>
                            <th>{{ __('Services ou conteneurs', 'dockerinventory') }}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in unmapped %}
                            <tr>
                                <td><code>{{ item.image }}</code></td>
                                <td>{{ item.count }}</td>
                                <td class="text-end">
                                    <a href="{{ page_url }}?add={{ item.image|url_encode }}#dockerinventory-new-mapping"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="ti ti-plus me-1" aria-hidden="true"></i>
                                        {{ __('Ajouter une correspondance', 'dockerinventory') }}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-arrows-exchange me-2" aria-hidden="true"></i>
                {{ __('Correspondance image → produit', 'dockerinventory') }}
                <span class="badge bg-secondary-lt ms-2">{{ mappings|length }}</span>
            </h3>
        </div>
        <div class="card-body pb-0 text-muted">
            {{ __(
                'Image : nom sans tag (postgres, bitnami/redis, registry.exemple.test/outils/api).',
                'dockerinventory'
            ) }}
            {{ __(
                'Produit : son nom dans la source, en minuscules (postgresql, nodejs, apache-http-server).',
                'dockerinventory'
            ) }}
        </div>
        <form method="post" action="{{ page_url }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <div class="table-responsive">
                <table class="table table-sm table-hover card-table align-middle">
                    <thead>
                        <tr>
                            <th>{{ __('Image', 'dockerinventory') }}</th>
                            <th>{{ __('Produit', 'dockerinventory') }}</th>
                            <th>{{ __('En service', 'dockerinventory') }}</th>
                            <th>{{ __('Cycles de vie', 'dockerinventory') }}</th>
                            <th class="text-center">{{ __('Supprimer', 'dockerinventory') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="dockerinventory-new-mapping" class="{{ add_image ? 'table-warning' : '' }}">
                            <td>
                                <input type="text" class="form-control form-control-sm" name="new_image"
                                       value="{{ add_image }}" maxlength="255"
                                       placeholder="{{ __('Nouvelle image', 'dockerinventory') }}"
                                       aria-label="{{ __('Nouvelle image', 'dockerinventory') }}">
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm" name="new_product"
                                       maxlength="64" {{ add_image ? 'autofocus' : '' }}
                                       placeholder="{{ __('Produit', 'dockerinventory') }}"
                                       aria-label="{{ __('Produit de la nouvelle image', 'dockerinventory') }}">
                            </td>
                            <td colspan="3" class="small text-muted">
                                <i class="ti ti-plus me-1" aria-hidden="true"></i>
                                {{ __('Nouvelle correspondance', 'dockerinventory') }}
                            </td>
                        </tr>
                        {% for mapping in mappings %}
                            <tr>
                                <td>
                                    <input type="text" class="form-control form-control-sm"
                                           name="rows[{{ mapping.id }}][image]" value="{{ mapping.image }}"
                                           maxlength="255" aria-label="{{ __('Image', 'dockerinventory') }}">
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm"
                                           name="rows[{{ mapping.id }}][product]" value="{{ mapping.product }}"
                                           maxlength="64" aria-label="{{ __('Produit', 'dockerinventory') }}">
                                </td>
                                <td>
                                    {% if mapping.in_use %}
                                        <span class="badge bg-blue-lt">{{ mapping.in_use }}</span>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                    {% if mapping.is_default %}
                                        <span class="badge bg-secondary-lt ms-1">
                                        {{ __('Fournie', 'dockerinventory') }}</span>
                                    {% endif %}
                                </td>
                                <td class="small">
                                    {% if mapping.error %}
                                        <span class="text-warning">
                                            <i class="ti ti-alert-triangle me-1" aria-hidden="true"></i>
                                            {{ error_labels[mapping.error]|default(mapping.error) }}
                                        </span>
                                    {% elseif mapping.checked %}
                                        <i class="ti ti-circle-check text-success me-1" aria-hidden="true"></i>
                                        {{ mapping.checked|formatted_datetime }}
                                    {% else %}
                                        <span class="text-muted">{{ __('Pas encore lus', 'dockerinventory') }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    <input class="form-check-input" type="checkbox" value="1"
                                           name="rows[{{ mapping.id }}][delete]"
                                           aria-label="{{ __('Supprimer', 'dockerinventory') }} {{ mapping.image }}">
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer text-end">
                <button type="submit" name="save_mappings" value="1" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1" aria-hidden="true"></i>
                    {{ __('Enregistrer les correspondances', 'dockerinventory') }}
                </button>
            </div>
        </form>
    </div>
</div>
