{# Accessibilité (#42) : classes de badge et de texte au contraste suffisant (WCAG 1.4.3, 4,5:1).
   Les badges bg-X-lt et bg-X text-white de Tabler descendent à 2:1 pour le vert, l'orange ou le
   jaune ; bg-S-subtle text-S-emphasis (Bootstrap 5.3, variantes claire et sombre fournies par
   Tabler) garde la même couleur de sens avec un texte foncé. X : couleur Tabler, S : couleur
   sémantique. #}
{% macro semantic(color) -%}
    {{- {
        success: 'success', green: 'success', teal: 'success', lime: 'success',
        info: 'info', blue: 'info', azure: 'info', cyan: 'info', indigo: 'info', primary: 'info',
        warning: 'warning', orange: 'warning', yellow: 'warning',
        danger: 'danger', red: 'danger',
        secondary: 'secondary', purple: 'secondary', muted: 'secondary'
    }[color]|default('secondary') -}}
{%- endmacro %}

{% macro badge(color) -%}
    {%- import _self as tone -%}
    {%- set s = tone.semantic(color) -%}
    bg-{{ s }}-subtle text-{{ s }}-emphasis
{%- endmacro %}

{% macro text(color) -%}
    {%- import _self as tone -%}
    text-{{ tone.semantic(color) }}-emphasis
{%- endmacro %}
