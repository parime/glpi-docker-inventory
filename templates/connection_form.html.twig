{# Connexion Portainer ou WUD. La clé d'API (ou le mot de passe WUD) n'est jamais renvoyée au
   navigateur : le champ reste vide, et le laisser vide en modification conserve la valeur
   enregistrée. Le type est choisi avant (connection_type_choice) et ne change plus. #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    <input type="hidden" name="type" value="{{ item.fields['type'] }}">
    {% if is_harbor %}
        {% set key_helper = has_api_key
            ? __('Un mot de passe est enregistré (chiffré) : laisser vide pour le conserver.', 'dockerinventory')
            : __('Facultatif pour les projets publics.', 'dockerinventory') %}
    {% elseif is_wud %}
        {% set key_helper = has_api_key
            ? __('Un mot de passe est enregistré (chiffré) : laisser vide pour le conserver.', 'dockerinventory')
            : __('Facultatif : seulement si WUD demande une authentification.', 'dockerinventory') %}
    {% else %}
        {% set key_helper = has_api_key
            ? __('Une clé est enregistrée (chiffrée) : laisser vide pour la conserver.', 'dockerinventory')
            : __("Jeton d'accès d'un utilisateur Portainer dédié, aux droits de lecture seuls.", 'dockerinventory') %}
    {% endif %}
    {% set environment_helper = __(
        "Appliqué seulement aux applications créées par l'import, jamais aux applications existantes.",
        'dockerinventory'
    ) %}
    {% set type_html %}
        {% set type_color = is_harbor ? 'bg-indigo' : (is_wud ? 'bg-teal' : 'bg-blue') %}
        {% set type_icon = is_harbor ? 'ti-building-warehouse' : (is_wud ? 'ti-tags' : 'ti-brand-docker') %}
        <span class="badge {{ type_color }} text-white">
            <i class="ti {{ type_icon }} me-1" aria-hidden="true"></i>{{ type_label }}
        </span>
    {% endset %}

    {{ fields.field('type_display', type_html, __('Type', 'dockerinventory')) }}
    {{ fields.textField('name', item.fields['name'], __('Name'), {
        required: true,
        helper: is_harbor
            ? __('Nom libre, par exemple « Harbor production ».', 'dockerinventory')
            : (is_wud
                ? __('Nom libre, par exemple « WUD production ».', 'dockerinventory')
                : __('Nom libre, par exemple « Portainer production ».', 'dockerinventory')),
    }) }}
    {{ fields.dropdownYesNo('is_active', item.isNewItem() ? 1 : item.fields['is_active'], __('Active'), {
        helper: __("Une connexion inactive n'est pas importée par la tâche automatique.", 'dockerinventory'),
    }) }}
    {% if is_harbor %}
        {{ fields.textField('url', item.fields['url'], __('Adresse de Harbor', 'dockerinventory'), {
            required: true,
            placeholder: 'https://harbor.exemple.test',
            helper: __('Adresse du registre Harbor, sans /v2 ni /api à la fin.', 'dockerinventory'),
        }) }}
        {% set host_label = __('Hôte dans les images', 'dockerinventory') %}
        {{ fields.textField('registry_host', item.fields['registry_host'] ?? '', host_label, {
            placeholder: 'harbor.exemple.test',
            helper: __(
                'Seulement s’il diffère de l’adresse : début des images (registry.exemple.test:5000/...).',
                'dockerinventory'
            ),
        }) }}
        {{ fields.textField('username', item.fields['username'] ?? '', __('Compte robot', 'dockerinventory'), {
            placeholder: 'robot$lecture',
            helper: __(
                'Compte robot Harbor avec le seul droit de lecture (pull) ; vide pour les projets publics.',
                'dockerinventory'
            ),
        }) }}
        {{ fields.passwordField('api_key', '', __('Mot de passe', 'dockerinventory'), {
            clearable: false,
            helper: key_helper,
        }) }}
        {% if has_api_key %}
            {{ fields.dropdownYesNo('_clear_api_key', 0, __('Effacer le mot de passe', 'dockerinventory'), {
                helper: __(
                    'Oui : le mot de passe enregistré est supprimé (projets publics seulement).',
                    'dockerinventory'
                ),
            }) }}
        {% endif %}
        {{ fields.dropdownYesNo('allow_http', item.fields['allow_http'] ?? 0, __('Autoriser HTTP', 'dockerinventory'), {
            helper: __('Déconseillé : le mot de passe circule alors en clair.', 'dockerinventory'),
        }) }}
    {% elseif is_wud %}
        {{ fields.textField('url', item.fields['url'], __('Adresse de WUD', 'dockerinventory'), {
            required: true,
            placeholder: 'https://wud.exemple.test:3000',
            helper: __("Adresse de l'interface de What's Up Docker, sans /api à la fin.", 'dockerinventory'),
        }) }}
        {{ fields.textField('username', item.fields['username'] ?? '', __('Utilisateur', 'dockerinventory'), {
            helper: __("Laisser vide si WUD n'a pas d'authentification.", 'dockerinventory'),
        }) }}
        {{ fields.passwordField('api_key', '', __('Mot de passe', 'dockerinventory'), {
            clearable: false,
            helper: key_helper,
        }) }}
        {% if has_api_key %}
            {{ fields.dropdownYesNo('_clear_api_key', 0, __('Effacer le mot de passe', 'dockerinventory'), {
                helper: __('Oui : le mot de passe enregistré est supprimé (WUD sans mot de passe).', 'dockerinventory'),
            }) }}
        {% endif %}
        {{ fields.dropdownYesNo('allow_http', item.fields['allow_http'] ?? 0, __('Autoriser HTTP', 'dockerinventory'), {
            helper: __('Déconseillé : le mot de passe circule alors en clair.', 'dockerinventory'),
        }) }}
    {% else %}
        {{ fields.textField('url', item.fields['url'], __('Adresse de Portainer', 'dockerinventory'), {
            required: true,
            placeholder: 'https://portainer.exemple.test:9443',
            helper: __("Adresse de l'interface Portainer, sans /api à la fin.", 'dockerinventory'),
        }) }}
        {{ fields.passwordField('api_key', '', __("Clé d'API", 'dockerinventory'), {
            required: item.isNewItem(),
            clearable: false,
            helper: key_helper,
        }) }}
        {{ fields.dropdownYesNo('allow_http', item.fields['allow_http'] ?? 0, __('Autoriser HTTP', 'dockerinventory'), {
            helper: __("Déconseillé : la clé d'API circule alors en clair.", 'dockerinventory'),
        }) }}
        {{ fields.dropdownField(
            'ApplianceEnvironment',
            'applianceenvironments_id',
            item.fields['applianceenvironments_id'],
            __('Environnement des applications créées', 'dockerinventory'),
            {helper: environment_helper}
        ) }}
    {% endif %}
    {{ fields.textareaField('comment', item.fields['comment'], _n('Comment', 'Comments', 1)) }}
    {% if not is_wud and not is_harbor %}
        {# Tickets de mise à jour des services de cette connexion (désactivés par défaut). #}
        {{ fields.largeTitle(__('Tickets de mise à jour', 'dockerinventory'), 'ti ti-ticket') }}
        {{ fields.dropdownYesNo('ticket_enabled', item.fields['ticket_enabled'] ?? 0,
            __('Créer des tickets de mise à jour', 'dockerinventory'), {
            helper: __(
                'Désactivé par défaut. Un ticket par service, puis des suivis : jamais de doublon.',
                'dockerinventory'
            ),
        }) }}
        {{ fields.dropdownArrayField('ticket_threshold', item.fields['ticket_threshold'] ?? 'major', thresholds,
            __('Seuil', 'dockerinventory'), {
            helper: __('Écart minimal entre la version déployée et la dernière version.', 'dockerinventory'),
        }) }}
        {{ fields.dropdownField('ITILCategory', 'ticket_itilcategories_id',
            item.fields['ticket_itilcategories_id'] ?? 0, __('Catégorie', 'dockerinventory')) }}
        {{ fields.dropdownField('Group', 'ticket_groups_id', item.fields['ticket_groups_id'] ?? 0,
            __('Groupe chargé du ticket', 'dockerinventory'), {
            condition: {is_assign: 1},
            helper: __('Affecté à la création seulement ; jamais modifié ensuite.', 'dockerinventory'),
        }) }}
        {{ fields.dropdownField('TicketTemplate', 'ticket_tickettemplates_id',
            item.fields['ticket_tickettemplates_id'] ?? 0, __('Modèle de ticket', 'dockerinventory'), {
            helper: __('Ses champs prédéfinis (type, urgence, demandeur...) servent de départ.', 'dockerinventory'),
        }) }}
        {% set vulnerability_html %}
            <span class="text-muted">
                <i class="ti ti-shield-lock me-1" aria-hidden="true"></i>
                {{ __('Vulnérabilité critique de l’image : avec Harbor, au lot 3.', 'dockerinventory') }}
            </span>
        {% endset %}
        {{ fields.htmlField('_ticket_vulnerability', vulnerability_html, __('Autre déclencheur', 'dockerinventory')) }}
        {# Tickets de fin de support (#26) : mêmes catégorie, groupe et modèle de ticket. #}
        {{ fields.largeTitle(__('Tickets de fin de support', 'dockerinventory'), 'ti ti-calendar-x') }}
        {{ fields.dropdownYesNo('ticket_eol_enabled', item.fields['ticket_eol_enabled'] ?? 0,
            __('Créer des tickets de fin de support', 'dockerinventory'), {
            helper: __(
                'Désactivé par défaut. La source des cycles de vie doit aussi être activée.',
                'dockerinventory'
            ),
        }) }}
        {{ fields.numberField('ticket_eol_days', item.fields['ticket_eol_days'] ?? 90,
            __('Délai avant la fin de support (jours)', 'dockerinventory'), {
            min: 0,
            max: 3650,
            helper: __(
                'Ticket quand la branche déployée arrive en fin de support dans ce délai (0 : une fois atteinte).',
                'dockerinventory'
            ),
        }) }}
        {% set eol_common_html %}
            <span class="text-muted">
                <i class="ti ti-info-circle me-1" aria-hidden="true"></i>
                {{ __('Catégorie, groupe et modèle : ceux des tickets de mise à jour ci-dessus.', 'dockerinventory') }}
            </span>
        {% endset %}
        {{ fields.htmlField('_ticket_eol_common', eol_common_html, __('Réglages communs', 'dockerinventory')) }}
    {% endif %}
{% endblock %}
