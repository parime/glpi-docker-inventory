{# Onglet « Versions » d'un service : provenance de l'image, artefact Harbor rattaché et résumé de son
   analyse de vulnérabilités (HarborArtifact::forService()). #}
{% if harbor.ticket %}
    <div class="alert {{ harbor.ticket.is_open ? 'alert-danger' : 'alert-secondary' }} d-flex align-items-center">
        <i class="ti ti-shield-exclamation me-2" aria-hidden="true"></i>
        <div>
            {{ __('Ticket de vulnérabilité', 'dockerinventory') }} :
            <a href="{{ harbor.ticket.url }}">#{{ harbor.ticket.id }} {{ harbor.ticket.name }}</a>
            <span class="badge bg-secondary-lt ms-1">{{ harbor.ticket.status }}</span>
        </div>
    </div>
{% endif %}
<div class="card mb-3">
    <div class="card-header d-flex flex-wrap align-items-center gap-2">
        <h3 class="card-title mb-0">
            <i class="ti ti-shield-search me-2" aria-hidden="true"></i>
            {{ __('Vulnérabilités de l’image (Harbor)', 'dockerinventory') }}
        </h3>
        {% if harbor.artifact %}
            {{ include('@dockerinventory/_severity_badge.html.twig', {
                severity: harbor.artifact.severity, artifact: harbor.artifact,
            }) }}
        {% endif %}
        {% if harbor.has_image %}
            <span class="badge bg-{{ harbor.provenance.color }}-lt ms-auto" title="{{ harbor.provenance.help }}"
                  data-bs-toggle="tooltip">
                <i class="{{ harbor.provenance.icon }} me-1" aria-hidden="true"></i>{{ harbor.provenance.label }}
            </span>
        {% endif %}
    </div>
    <div class="card-body">
        {% if not harbor.has_image %}
            <p class="text-muted mb-0">{{ __('Ce service n’a pas d’image connue.', 'dockerinventory') }}</p>
        {% else %}
            {% if harbor.provenance_code == 'unmanaged' %}
                <div class="alert alert-danger">
                    <i class="ti ti-world-download me-2" aria-hidden="true"></i>
                    <div>
                        <strong>{{ __('Image hors registre maîtrisé', 'dockerinventory') }}</strong> :
                        {{ __('elle vient de', 'dockerinventory') }} <code>{{ harbor.host ?: '-' }}</code>,
                        {{ __('qui n’est pas dans la liste des registres maîtrisés', 'dockerinventory') }}
                        ({% for host in harbor.managed_hosts -%}
                            <code>{{ host }}</code>{% if not loop.last %}, {% endif %}
                        {%- else -%}
                            <code>-</code>
                        {%- endfor %}).
                        {{ __(
                        'Elle n’est ni analysée ni contrôlée par Harbor : la reconstruire depuis le registre maîtrisé.',
                            'dockerinventory'
                        ) }}
                    </div>
                </div>
            {% endif %}
            {% if harbor.artifact %}
                {% set artifact = harbor.artifact %}
                {% if harbor.method == 'tag_digest_differs' %}
                    <div class="alert alert-info">
                        <i class="ti ti-arrows-shuffle me-2" aria-hidden="true"></i>
                        {{ harbor.method_label }}.
                        {{ __(
                'Souvent une image multi-plateforme poussée depuis un hôte (Harbor n’en garde qu’une plateforme).',
                            'dockerinventory'
                        ) }}
                        {{ __(
                            'L’analyse ci-dessous est celle de l’image actuelle de ce tag.',
                            'dockerinventory'
                        ) }}
                    </div>
                {% endif %}
                {% if artifact.scanned %}
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        {% for code, count in artifact.counts %}
                            {% set info = harbor.severities[code] %}
                            <div class="card card-sm" style="min-width: 8rem">
                                <div class="card-body d-flex align-items-center gap-2 py-2">
                                    {% set avatar = count > 0
                                        ? 'bg-' ~ info.color ~ ' text-white' : 'bg-secondary-lt' %}
                                    <span class="avatar avatar-sm {{ avatar }}">
                                        <i class="{{ info.icon }}" aria-hidden="true"></i>
                                    </span>
                                    <div>
                                        <div class="fw-bold fs-3">{{ count }}</div>
                                        <div class="text-muted small">{{ info.label }}</div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="alert alert-secondary">
                        <i class="ti ti-help-circle me-2" aria-hidden="true"></i>
                        {{ artifact.status_label }} :
                        {{ __('aucun résultat d’analyse pour cette image dans Harbor.', 'dockerinventory') }}
                    </div>
                {% endif %}
                <dl class="row mb-0">
                    <dt class="col-sm-3">{{ __('Artefact Harbor', 'dockerinventory') }}</dt>
                    <dd class="col-sm-9">
                        {{ artifact.repository }}
                        {% if harbor.connection %}<span class="text-muted">({{ harbor.connection }})</span>{% endif %}
                    </dd>
                    <dt class="col-sm-3">{{ __('Rattachement', 'dockerinventory') }}</dt>
                    <dd class="col-sm-9">{{ harbor.method_label }}</dd>
                    <dt class="col-sm-3">{{ __('Empreinte', 'dockerinventory') }}</dt>
                    <dd class="col-sm-9"><code>{{ artifact.digest }}</code></dd>
                    <dt class="col-sm-3">{{ __('Tags', 'dockerinventory') }}</dt>
                    <dd class="col-sm-9">
                        {% for tag in artifact.tags %}
                            <span class="badge bg-blue-lt me-1">{{ tag }}</span>
                        {% else %}
                            <span class="text-muted">{{ __('sans tag', 'dockerinventory') }}</span>
                        {% endfor %}
                    </dd>
                    <dt class="col-sm-3">{{ __('Publié le', 'dockerinventory') }}</dt>
                    <dd class="col-sm-9">
                        {{ artifact.push_time ? artifact.push_time|formatted_datetime : '-' }}
                        {% if artifact.size %}<span class="text-muted ms-2">({{ artifact.size }})</span>{% endif %}
                    </dd>
                    <dt class="col-sm-3">{{ __('Analyse', 'dockerinventory') }}</dt>
                    <dd class="col-sm-9">
                        {{ artifact.status_label -}}
                        {%- if artifact.scanner %}, {{ artifact.scanner }}{% endif -%}
                        {%- if artifact.scan_time %}, {{ artifact.scan_time|formatted_datetime }}{% endif %}
                        {% if artifact.scanned %}
                            <div class="text-muted small">
                                {{ __('Total', 'dockerinventory') }} : {{ artifact.total }},
                                {{ __('corrigibles', 'dockerinventory') }} : {{ artifact.fixable }}
                            </div>
                        {% endif %}
                    </dd>
                </dl>
            {% elseif harbor.in_harbor %}
                <div class="alert alert-warning">
                    <i class="ti ti-package-off me-2" aria-hidden="true"></i>
                    {{ __('Image introuvable dans Harbor', 'dockerinventory') }} :
                    <code>{{ harbor.repository }}</code>
                    {{ __(
                        '(ni par son empreinte, ni par son tag). Harbor est lu toutes les heures.',
                        'dockerinventory'
                    ) }}
                </div>
            {% elseif harbor.provenance_code != 'unmanaged' %}
                <p class="text-muted mb-0">
                    {% if harbor.has_harbor %}
                        {{ __(
                            'Image hors des registres Harbor déclarés : pas d’analyse de vulnérabilités connue.',
                            'dockerinventory'
                        ) }}
                    {% else %}
                        {{ __('Aucune connexion Harbor : pas d’analyse de vulnérabilités connue.', 'dockerinventory') }}
                    {% endif %}
                </p>
            {% endif %}
        {% endif %}
        <p class="text-muted small mt-2 mb-0">
            <a href="{{ harbor.page_url }}">
                {{- __('Voir toutes les images Harbor et leurs vulnérabilités', 'dockerinventory') -}}
            </a>
        </p>
    </div>
</div>
