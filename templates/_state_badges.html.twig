{# État des conteneurs d'un service Compose ou d'un conteneur autonome (running, exited...). #}
{% for state in states %}
    {% if state == 'running' %}
        <span class="badge bg-success-lt me-1">
            <i class="ti ti-player-play me-1" aria-hidden="true"></i>{{ __('En cours', 'dockerinventory') }}
        </span>
    {% elseif state in ['exited', 'dead'] %}
        <span class="badge bg-danger-lt me-1">
            <i class="ti ti-player-stop me-1" aria-hidden="true"></i>{{ __('Arrêté', 'dockerinventory') }}
            ({{ state }})
        </span>
    {% else %}
        <span class="badge bg-warning-lt me-1">
            <i class="ti ti-alert-triangle me-1" aria-hidden="true"></i>{{ state }}
        </span>
    {% endif %}
{% else %}
    <span class="text-muted">-</span>
{% endfor %}
