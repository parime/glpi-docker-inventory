{# Encadré « À quoi sert cette page ? » en tête de chaque page d’usage (charte commune, section 8 ;
   issue #39). Repliable, choix mémorisé par page dans le navigateur. Repris de glpi-plugin-template,
   msgid en français comme le reste du plugin. Inclus seulement après le contrôle de droit de la
   page : il n’affiche que du texte fixe.
   Usage : {{ include('@dockerinventory/_page_help.html.twig', {page: 'versions', purpose: …, expected: …}) }} #}
{% set help_id = 'dockerinventory-help-' ~ page %}
<div class="card border-info-subtle mb-3">
    <div class="card-body py-2">
        <a class="d-flex align-items-center text-decoration-none" data-bs-toggle="collapse" href="#{{ help_id }}"
           role="button" aria-expanded="true" aria-controls="{{ help_id }}">
            <i class="ti ti-help-circle text-info me-2" aria-hidden="true"></i>
            <strong>{{ __('À quoi sert cette page ?', 'dockerinventory') }}</strong>
            <i class="ti ti-chevron-down ms-auto" aria-hidden="true"></i>
        </a>
        <div class="collapse show" id="{{ help_id }}">
            <p class="mb-1 mt-2">{{ purpose }}</p>
            <p class="mb-1">
                <i class="ti ti-checklist me-1 text-muted" aria-hidden="true"></i>
                <strong>{{ __('Ce qui est attendu :', 'dockerinventory') }}</strong> {{ expected }}
            </p>
            {% if reference is defined and reference %}
                <p class="mb-0 small text-muted"><i class="ti ti-book me-1" aria-hidden="true"></i>{{ reference }}</p>
            {% endif %}
        </div>
    </div>
</div>
<script>
    (function () {
        const key = 'dockerinventory.help.{{ page|e('js') }}';
        const panel = document.getElementById('{{ help_id|e('js') }}');
        try {
            if (window.localStorage.getItem(key) === 'hidden') {
                panel.classList.remove('show');
            }
            panel.addEventListener('hidden.bs.collapse', function () { window.localStorage.setItem(key, 'hidden'); });
            panel.addEventListener('shown.bs.collapse', function () { window.localStorage.removeItem(key); });
        } catch (e) {
            // Stockage du navigateur indisponible : l’encadré reste simplement ouvert.
        }
    })();
</script>
