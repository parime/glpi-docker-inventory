{# Onglet « Versions » d'un service (détail) ou d'une application (tableau de ses services). #}
{% if rows is empty %}
    <div class="alert alert-info">
        <i class="ti ti-info-circle me-2" aria-hidden="true"></i>
        {% if not has_wud and not has_registry %}
            {{ __('Aucune version connue pour le moment.', 'dockerinventory') }}
            {{ __(
                'Ajoutez une connexion WUD, ou lancez la vérification des registres (toutes les heures).',
                'dockerinventory'
            ) }}
            {% if can_configure %}
                <a href="{{ connection_url }}" class="ms-1">{{ __('Connexions Docker', 'dockerinventory') }}</a>
            {% endif %}
        {% elseif for_service %}
            {{ __('Aucune version connue pour ce service (ni WUD, ni registre).', 'dockerinventory') }}
            {{ __('Les registres sont vérifiés toutes les heures pour les services sans WUD.', 'dockerinventory') }}
        {% else %}
            {{ __('Aucune version connue pour les services de cette application.', 'dockerinventory') }}
        {% endif %}
    </div>
{% elseif for_service %}
    {% if update_ticket %}
        <div class="alert {{ update_ticket.is_open ? 'alert-warning' : 'alert-secondary' }} d-flex align-items-center">
            <i class="ti ti-ticket me-2" aria-hidden="true"></i>
            <div>
                {{ __('Ticket de mise à jour', 'dockerinventory') }} :
                <a href="{{ update_ticket.url }}">#{{ update_ticket.id }} {{ update_ticket.name }}</a>
                <span class="badge bg-secondary-lt ms-1">{{ update_ticket.status }}</span>
            </div>
        </div>
    {% endif %}
    {% if eol_ticket %}
        <div class="alert {{ eol_ticket.is_open ? 'alert-warning' : 'alert-secondary' }} d-flex align-items-center">
            <i class="ti ti-calendar-x me-2" aria-hidden="true"></i>
            <div>
                {{ __('Ticket de fin de support', 'dockerinventory') }} :
                <a href="{{ eol_ticket.url }}">#{{ eol_ticket.id }} {{ eol_ticket.name }}</a>
                <span class="badge bg-secondary-lt ms-1">{{ eol_ticket.status }}</span>
            </div>
        </div>
    {% endif %}
    {% for row in rows %}
        <div class="card mb-3">
            <div class="card-header d-flex flex-wrap align-items-center gap-2">
                <h3 class="card-title mb-0">
                    <i class="ti ti-tags me-2" aria-hidden="true"></i>
                    {{ __('Version de l’image', 'dockerinventory') }}
                </h3>
                {{ include('@dockerinventory/_version_badge.html.twig', {gap: row.gap}) }}
                {% if eol_enabled %}
                    {{ include('@dockerinventory/_eol_badge.html.twig', {eol: row.eol, compact: true}) }}
                {% endif %}
                {% if row.is_out_of_sync %}
                    <span class="badge bg-warning text-white">
                        <i class="ti ti-arrows-split me-1" aria-hidden="true"></i>
                        {{ __('Réplicas désynchronisés', 'dockerinventory') }}
                    </span>
                {% endif %}
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center gap-3 mb-3 fs-3">
                    <span class="badge bg-blue-lt fs-3">{{ row.deployed_tag ?: '-' }}</span>
                    <i class="ti ti-arrow-right text-muted" aria-hidden="true"></i>
                    <span class="badge bg-green-lt fs-3">{{ row.latest_tag ?: '-' }}</span>
                    <span class="text-muted fs-5">{{ row.gap.help }}</span>
                </div>
                {% if row.is_out_of_sync %}
                    <div class="alert alert-warning">
                        <i class="ti ti-arrows-split me-2" aria-hidden="true"></i>
                        <div>
                            {{ __(
                                'Conteneurs dans des versions différentes (mise à jour en cours ou bloquée) :',
                                'dockerinventory'
                            ) }}
                            <strong>{{ row.deployed_versions }}</strong>
                        </div>
                    </div>
                {% endif %}
                {% if row.gap_code == 'untrackable' %}
                    <div class="alert alert-secondary">
                        <i class="ti ti-eye-off me-2" aria-hidden="true"></i>
                        {{ __('Ce tag ne désigne pas une version précise.', 'dockerinventory') }}
                        {{ __(
                            'Préférer un tag versionné (1.2.3) pour savoir ce qui tourne vraiment.',
                            'dockerinventory'
                        ) }}
                        {% if row.update_available %}
                            {{ __('Une nouvelle empreinte est disponible pour ce tag.', 'dockerinventory') }}
                        {% endif %}
                    </div>
                {% endif %}
                <dl class="row mb-0">
                    <dt class="col-sm-3">{{ __('Image', 'dockerinventory') }}</dt>
                    <dd class="col-sm-9">
                        {{ row.image ?: '-' }}
                        {% if row.registry_link %}
                            <a href="{{ row.registry_link }}" target="_blank" rel="noopener noreferrer" class="ms-2">
                                <i class="ti ti-external-link me-1" aria-hidden="true"></i>
                                {{ __('Page du registre', 'dockerinventory') }}
                            </a>
                        {% elseif row.registry_name %}
                            <span class="text-muted ms-2">(
                            {{ __('Registre', 'dockerinventory') }} : {{ row.registry_name }})</span>
                        {% endif %}
                    </dd>
                    <dt class="col-sm-3">{{ __('Empreinte déployée', 'dockerinventory') }}</dt>
                    <dd class="col-sm-9"><code>{{ row.deployed_digest ?: '-' }}</code></dd>
                    {% if row.digest_changed %}
                        <dt class="col-sm-3">{{ __('Dernière empreinte', 'dockerinventory') }}</dt>
                        <dd class="col-sm-9"><code>{{ row.latest_digest }}</code></dd>
                    {% endif %}
                    {% if row.source_code != 'registry' %}
                        <dt class="col-sm-3">{{ __('Conteneurs WUD', 'dockerinventory') }}</dt>
                        <dd class="col-sm-9">
                            {% for name in row.containers %}
                                <span class="badge bg-secondary-lt me-1 mb-1">{{ name }}</span>
                            {% endfor %}
                        </dd>
                        <dt class="col-sm-3">{{ __('Rattachement', 'dockerinventory') }}</dt>
                        <dd class="col-sm-9">{{ row.match }}</dd>
                    {% endif %}
                    <dt class="col-sm-3">{{ __('Source', 'dockerinventory') }}</dt>
                    <dd class="col-sm-9">
                        {{ row.source }}
                        {% if row.connection_name %}({{ row.connection_name }}){% endif %}
                        {% if row.source_code == 'registry' and row.registry_name and not row.connection_name %}
                            <span class="text-muted">
                                : {{ row.registry_name == 'hub' ? 'Docker Hub' : row.registry_name }}
                            </span>
                        {% endif %}
                    </dd>
                    <dt class="col-sm-3">{{ __('Fin de support', 'dockerinventory') }}</dt>
                    <dd class="col-sm-9">
                        {% if eol_enabled %}
                            {{ include('@dockerinventory/_eol_badge.html.twig', {eol: row.eol, compact: true}) }}
                            {% if row.eol.cycle %}
                                <span class="ms-2">
                                    {{ __('Branche', 'dockerinventory') }} {{ row.eol.product }} {{ row.eol.cycle }}
                                    {% if row.eol.latest %}
                                        ({{ __('dernière version de la branche', 'dockerinventory') }} :
                                        {{ row.eol.latest }})
                                    {% endif %}
                                </span>
                            {% endif %}
                            <div class="text-muted small">
                                {{ row.eol.detail }}
                                {% if row.eol.product_url %}
                                    <a href="{{ row.eol.product_url }}" target="_blank" rel="noopener noreferrer"
                                       class="ms-1">
                                        <i class="ti ti-external-link me-1" aria-hidden="true"></i>endoflife.date
                                    </a>
                                {% endif %}
                                {% set fixable = row.eol.reason in ['no_product', 'product_not_found'] %}
                                {% if can_configure_lifecycle and fixable %}
                                    <a href="{{ lifecycle_url }}" class="ms-1">
                                    {{ __('Ajouter ou corriger la correspondance', 'dockerinventory') }}</a>
                                {% endif %}
                            </div>
                        {% else %}
                            <span class="text-muted">
                            {{ __('Non vérifiée : source des cycles de vie désactivée.', 'dockerinventory') }}</span>
                            {% if can_configure_lifecycle %}
                                <a href="{{ lifecycle_url }}" class="ms-1">{{ __('Activer', 'dockerinventory') }}</a>
                            {% endif %}
                        {% endif %}
                    </dd>
                    <dt class="col-sm-3">{{ __('Vérifié le', 'dockerinventory') }}</dt>
                    <dd class="col-sm-9">{{ row.date_checked|formatted_datetime }}</dd>
                    {% if row.error %}
                        {% if row.source_code == 'registry' %}
                            <dt class="col-sm-3">{{ __('Pourquoi non vérifié', 'dockerinventory') }}</dt>
                            <dd class="col-sm-9 text-warning">{{ row.error }}</dd>
                        {% else %}
                            <dt class="col-sm-3">{{ __('Erreur WUD', 'dockerinventory') }}</dt>
                            <dd class="col-sm-9 text-danger">{{ row.error }}</dd>
                        {% endif %}
                    {% endif %}
                </dl>
            </div>
        </div>
    {% endfor %}
{% else %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-tags me-2" aria-hidden="true"></i>
                {{ __('Versions des images de cette application', 'dockerinventory') }}
            </h3>
        </div>
        <div class="table-responsive">
            {{ include('@dockerinventory/_version_rows.html.twig', {
                rows: rows, hide_appliance: true, eol_enabled: eol_enabled,
            }) }}
        </div>
    </div>
{% endif %}
<p class="text-muted small mt-2">
    {{ __(
        'Versions lues dans What’s Up Docker ou dans le registre de l’image, sans rien y modifier.',
        'dockerinventory'
    ) }}
    <a href="{{ overview_url }}">{{ __('Voir toutes les versions des images', 'dockerinventory') }}</a>
</p>
