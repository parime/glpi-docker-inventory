{# Filtre « sans sauvegarde » de la liste des services (#78) : nombre de services actifs visibles dont un
   volume n'a pas de sauvegarde déclarée, et lien vers la liste filtrée. backups : VolumeBackup::overview(). #}
{% if backups.services_with_volumes > 0 %}
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <span class="text-muted">
            <i class="ti ti-database-export me-1" aria-hidden="true"></i>
            {{ __('Volumes déclarés sauvegardés : %1$d sur %2$d', 'dockerinventory')
                |format(backups.backed_up, backups.volumes) }}
        </span>
        {% if backups.services_unbacked > 0 %}
            <a href="{{ list_url }}" class="btn btn-sm btn-outline-warning">
                <i class="ti ti-alert-triangle me-1" aria-hidden="true"></i>
                {{ __('Sans sauvegarde déclarée', 'dockerinventory') }}
                <span class="badge bg-warning-subtle text-warning-emphasis ms-1">{{ backups.services_unbacked }}</span>
            </a>
        {% endif %}
    </div>
{% endif %}
