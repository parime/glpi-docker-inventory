{% import '@dockerinventory/_tone.html.twig' as tone %}

{# Sous-page « Exposition » de l'entrée Inventaire Docker (#72) : services actifs qui publient un port
   ou déclarent une route d'entrée ; filtres « exposés sur Internet » et « sans flux documenté »
   (GRC Manager), routes appliquées par chaque Traefik. Lecture seule (GET), entités actives ; seule
   « Lire Traefik maintenant » (droit de mise à jour de la configuration) lit Traefik (#118). #}
<div class="container-fluid">
    {{ include('@dockerinventory/_page_help.html.twig', {
        page: 'exposure',
        purpose: __(
            'Voir ce qui est réellement joignable : ports publiés, routes Traefik, ingress et services Kubernetes.',
            'dockerinventory'
        ),
        expected: __(
            'Vérifiez que chaque service exposé sur Internet est voulu et documenté dans la matrice des flux.',
            'dockerinventory'
        ) ~ ' ' ~ __('Le plugin ne modifie rien, ni dans les plateformes ni dans GRC Manager.', 'dockerinventory'),
    }) }}
    {{ include('@dockerinventory/_section_nav.html.twig') }}
    <div class="card mb-3">
        <div class="card-header">
            <h2 class="card-title mb-0">
                <i class="ti ti-world-share me-2" aria-hidden="true"></i>{{ __('Services exposés', 'dockerinventory') }}
            </h2>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ page_url }}" class="btn btn-sm {{ filter == '' ? 'btn-dark' : 'btn-outline-dark' }}">
                    <i class="ti ti-list me-1" aria-hidden="true"></i>{{ __('Tous', 'dockerinventory') }}
                    <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">{{ counts.exposed }}</span>
                </a>
                <a href="{{ page_url }}&filter={{ internet }}"
                   class="btn btn-sm {{ filter == internet ? 'btn-danger' : 'btn-outline-danger' }}">
                    <i class="ti ti-world me-1" aria-hidden="true"></i>
                    {{ __('Exposés sur Internet', 'dockerinventory') }}
                    <span class="badge bg-danger-subtle text-danger-emphasis ms-1">{{ counts.internet }}</span>
                </a>
                {% if grc.available %}
                    <a href="{{ page_url }}&filter={{ undocumented }}"
                       class="btn btn-sm {{ filter == undocumented ? 'btn-warning' : 'btn-outline-warning' }}">
                        <i class="ti ti-alert-triangle me-1" aria-hidden="true"></i>
                        {{ __('Sans flux documenté', 'dockerinventory') }}
                        <span class="badge bg-warning-subtle text-warning-emphasis ms-1">
                            {{ counts.undocumented }}
                        </span>
                    </a>
                {% endif %}
            </div>
            {{ include('@dockerinventory/_exposure_grc.html.twig') }}
        </div>
    </div>

    <div class="card mb-3">
        {% if services is empty %}
            <div class="card-body">
                <div class="empty">
                    <div class="empty-icon"><i class="ti ti-shield-check text-success" aria-hidden="true"></i></div>
                    <p class="empty-title">{{ __('Aucun service ne correspond à ces filtres.', 'dockerinventory') }}</p>
                    <p class="empty-subtitle text-muted">
                        {{ __(
                            'Les ports et les routes sont relevés à chaque import Portainer ou Kubernetes.',
                            'dockerinventory'
                        ) }}
                    </p>
                </div>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    {{ include('@dockerinventory/_exposure_head.html.twig', {show_service: true}) }}
                    <tbody>
                        {% for service in services %}
                            {{ include('@dockerinventory/_exposure_rows.html.twig', {
                                service: service,
                                show_service: true,
                            }) }}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
    {{ include('@dockerinventory/_certificates.html.twig') }}
    <p class="text-muted small">
        <i class="ti ti-help-circle me-1" aria-hidden="true"></i>
        {{ __(
            'Une route HTTP est comptée sur le port 443 avec TLS, 80 sinon : le port réel est celui du point d’entrée.',
            'dockerinventory'
        ) }}
    </p>
    {# Routes appliquées par Traefik (#80), d'après la dernière lecture de chaque connexion, et
       lecture sur clic (#118) : avant sur la fiche de la connexion, dans la configuration. #}
    {% for source in traefik_sources %}
        <div class="card mb-3">
            <div class="card-header d-flex flex-wrap align-items-center gap-2">
                <h2 class="card-title mb-0">
                    <i class="ti ti-route me-2" aria-hidden="true"></i>
                    {{ __('Routes appliquées par Traefik', 'dockerinventory') }} :
                    {% if form_url %}
                        <a href="{{ form_url }}?id={{ source.id }}">{{ source.name }}</a>
                    {% else %}
                        {{ source.name }}
                    {% endif %}
                </h2>
                <span class="badge {{ tone.badge(source.status_color) }}">{{ source.status_label }}</span>
                {% if source.date %}
                    <span class="text-muted small">{{ source.date|formatted_datetime }}</span>
                {% endif %}
                {% if source.report and source.report.traefik_version|default('') %}
                    <span class="badge bg-success-subtle text-success-emphasis">
                        Traefik {{ source.report.traefik_version }}
                    </span>
                {% endif %}
                {% if can_run and source.is_active %}
                    <form method="post" action="{{ read_url }}" class="ms-auto">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="id" value="{{ source.id }}">
                        <button type="submit" name="read" value="1" class="btn btn-outline-primary btn-sm">
                            <i class="ti ti-refresh me-1" aria-hidden="true"></i>
                            {{- __('Lire Traefik maintenant', 'dockerinventory') -}}
                        </button>
                    </form>
                {% endif %}
            </div>
            <div class="card-body">
                <p class="text-muted">
                    {{ __(
                        'Comparer les routes vraiment appliquées par Traefik aux étiquettes des services inventoriés.',
                        'dockerinventory'
                    ) }}
                    {{ __(
                'Rien n’est modifié dans Traefik : seules des lectures GET sont envoyées, à l’adresse de la connexion.',
                        'dockerinventory'
                    ) }}
                </p>
                {% if source.report and source.report.errors|default([]) is not empty %}
                    <div class="alert alert-warning">
                        <ul class="mb-0">
                            {% for error in source.report.errors %}
                                <li>{{ error_labels[error.code] ?? error.code }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
                {% if source.report %}
                    {{ include('@dockerinventory/_traefik_routes.html.twig', {report: source.report}) }}
                {% else %}
                    <p class="text-muted mb-0">
                        {{ __(
                            'Pas encore lu : pas de tâche automatique, la lecture se fait sur clic.',
                            'dockerinventory'
                        ) }}
                    </p>
                {% endif %}
            </div>
        </div>
    {% endfor %}
</div>
