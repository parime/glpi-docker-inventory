{# Contenu HTML du modèle de notification « Exception qui expire bientôt » (#99), rendu une fois à
   l'installation (ExpiryNotification::content()) ; GLPI remplace ensuite les balises ##exception.*##.
   labels : libellé par balise ; advice : conduite à tenir. #}
<p><strong>##exception.action##</strong></p>
<table cellpadding="4">
    {% for tag, label in labels %}
        <tr>
            <th align="left" valign="top">{{ label }}</th>
            <td>##exception.{{ tag }}##</td>
        </tr>
    {% endfor %}
</table>
<p>{{ advice }}</p>
<p><a href="##exception.url##">##exception.url##</a></p>
