{# Suivi d'un ticket de vulnérabilité encore ouvert, quand la situation du service change. #}
<p>
    {% if kind == 'resolved' %}
        <strong>{{ __('Plus de vulnérabilité au seuil', 'dockerinventory') }}</strong> :
    {% else %}
        <strong>{{ __('Nouvelle situation', 'dockerinventory') }}</strong> :
    {% endif %}
    {{ image }}{% if tag %}:{{ tag }}{% endif %},
    {{ critical }} {{ __('critiques', 'dockerinventory') }}, {{ high }} {{ __('hautes', 'dockerinventory') }}.
    {% if digest != previous.digest %}
        {{ __('Image redéployée ou reconstruite', 'dockerinventory') }} : <code>{{ digest }}</code>.
    {% endif %}
</p>
<p>
    {{ __('Situation précédente', 'dockerinventory') }} :
    {{ previous.critical }} {{ __('critiques', 'dockerinventory') }},
    {{ previous.high }} {{ __('hautes', 'dockerinventory') }}.
</p>
<p>
    {{ __('Suivi ajouté par Inventaire Docker : le statut du ticket n’est pas modifié.', 'dockerinventory') }}
    <a href="{{ service_url }}">{{ __('Voir le service dans GLPI', 'dockerinventory') }}</a>
</p>
