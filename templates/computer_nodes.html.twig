{# Onglet « Services du nœud » d'un ordinateur : nœud(s) Swarm ou hôte Docker autonome rattachés, et
   leurs services. #}
{% if nodes is empty %}
    <div class="alert alert-info">
        <i class="ti ti-info-circle me-2" aria-hidden="true"></i>
        {{ __("Cet ordinateur n'est rattaché à aucun nœud Swarm ni hôte Docker.", 'dockerinventory') }}
        {{ __("Le rattachement se fait à l'import Portainer, par nom d'hôte.", 'dockerinventory') }}
    </div>
{% endif %}
{% for node in nodes %}
    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap align-items-center gap-2">
            <h3 class="card-title mb-0">
                <i class="ti ti-server me-2" aria-hidden="true"></i>{{ node.hostname }}
            </h3>
            {% if node.role == 'standalone' %}
                <span class="badge bg-teal text-white">
                    <i class="ti ti-box me-1" aria-hidden="true"></i>{{ __('Hôte Docker autonome', 'dockerinventory') }}
                </span>
            {% else %}
                <span class="badge {{ node.role == 'manager' ? 'bg-purple' : 'bg-blue' }} text-white">
                    {{ node.role }}
                </span>
            {% endif %}
            {% set state_class = node.state == 'ready' ? 'bg-success' : 'bg-danger' %}
            <span class="badge {{ state_class }} text-white">{{ node.state }}</span>
            {% if node.availability and node.availability != 'active' %}
                <span class="badge bg-warning text-white">{{ node.availability }}</span>
            {% endif %}
            {% if node.is_retired %}
                <span class="badge bg-secondary text-white">{{ __('Retiré', 'dockerinventory') }}</span>
            {% endif %}
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">{{ __('Version de Docker', 'dockerinventory') }}</dt>
                <dd class="col-sm-9">{{ node.engine_version ?: '-' }}</dd>
                <dt class="col-sm-3">{{ __('Adresse', 'dockerinventory') }}</dt>
                <dd class="col-sm-9">{{ node.address ?: '-' }}</dd>
                <dt class="col-sm-3">{{ __('Vu la dernière fois', 'dockerinventory') }}</dt>
                <dd class="col-sm-9">{{ node.last_seen|formatted_datetime }}</dd>
            </dl>
        </div>
        {% if node.services is empty %}
            <div class="card-body pt-0 text-muted">
                {% if node.role == 'standalone' %}
                    {{ __('Aucun conteneur en cours sur cet hôte.', 'dockerinventory') }}
                {% else %}
                    {{ __('Aucune tâche de service en cours sur ce nœud.', 'dockerinventory') }}
                {% endif %}
            </div>
        {% else %}
            <div class="table-responsive">
                {{ include('@dockerinventory/_service_rows.html.twig', {services: node.services, show_tasks: true}) }}
            </div>
        {% endif %}
    </div>
{% endfor %}
