{# Contenu HTML du modèle de notification « Certificat TLS qui expire bientôt » (#78), rendu une fois à
   l'installation (CertificateNotification::content()) ; GLPI remplace ensuite les balises
   ##certificate.*##. fields : balises affichées avec leur libellé (##lang.certificate.x##, traduit à
   l'envoi). #}
<p><strong>##certificate.action##</strong></p>
<table cellpadding="4">
    {% for field in fields %}
        <tr>
            <th align="left" valign="top">##lang.certificate.{{ field }}##</th>
            <td>##certificate.{{ field }}##</td>
        </tr>
    {% endfor %}
</table>
<p>##certificate.advice##</p>
<p><a href="##certificate.url##">##certificate.url##</a></p>
