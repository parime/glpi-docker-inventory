{# Nouvelle connexion : choix du type, dont dépendent les champs du formulaire. #}
<div class="container-fluid py-3">
    <h3 class="mb-1">{{ __('Quelle source voulez-vous connecter ?', 'dockerinventory') }}</h3>
    <p class="text-muted mb-4">
        {{ __('Le plugin lit ces outils sans jamais rien y modifier.', 'dockerinventory') }}
        {{ __('Commencez par Portainer : WUD complète les services que Portainer a importés.', 'dockerinventory') }}
        {{ __('Sans WUD, Docker Hub est lu directement ; Harbor sert aux images de vos projets.', 'dockerinventory') }}
    </p>
    <div class="row g-3">
        <div class="col-md-4">
            <a class="card card-link card-link-pop h-100 text-reset text-decoration-none"
               href="{{ form_url }}?type=portainer">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <span class="avatar bg-blue text-white me-3">
                            <i class="ti ti-brand-docker fs-2" aria-hidden="true"></i>
                        </span>
                        <h4 class="card-title mb-0">Portainer</h4>
                    </div>
                    <p class="text-muted mb-0">
                        {{ __(
                            'Stacks Swarm et Compose, services, conteneurs et hôtes : ce qui tourne, et où.',
                            'dockerinventory'
                        ) }}
                    </p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a class="card card-link card-link-pop h-100 text-reset text-decoration-none"
               href="{{ form_url }}?type=wud">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <span class="avatar bg-teal text-white me-3">
                            <i class="ti ti-tags fs-2" aria-hidden="true"></i>
                        </span>
                        <h4 class="card-title mb-0">What's Up Docker (WUD)</h4>
                    </div>
                    <p class="text-muted mb-0">
                        {{ __('Version déployée et dernière version disponible de chaque image.', 'dockerinventory') }}
                    </p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a class="card card-link card-link-pop h-100 text-reset text-decoration-none"
               href="{{ form_url }}?type=harbor">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <span class="avatar bg-indigo text-white me-3">
                            <i class="ti ti-building-warehouse fs-2" aria-hidden="true"></i>
                        </span>
                        <h4 class="card-title mb-0">Harbor</h4>
                    </div>
                    <p class="text-muted mb-0">
                        {{ __('Registre privé : dernières versions de vos images, sans WUD.', 'dockerinventory') }}
                    </p>
                </div>
            </a>
        </div>
    </div>
</div>
