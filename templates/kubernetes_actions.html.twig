{# Sous le formulaire d'une connexion Kubernetes enregistrée : test, import immédiat, dernier compte rendu. #}
{% set status_colors = {0: 'secondary', 1: 'success', 2: 'warning', 3: 'danger', 4: 'warning'} %}
{% set status = item.fields['last_import_status']|default(0) %}

<div class="card mt-3">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ti ti-brand-kubernetes me-2" aria-hidden="true"></i>
            {{ __('Import depuis Kubernetes', 'dockerinventory') }}
        </h3>
    </div>
    <div class="card-body">
        <p class="text-muted">
            {{ __("L'import lit le cluster sans rien y modifier et tourne toutes les heures.", 'dockerinventory') }}
            {{ __('Le bouton « Importer maintenant » le lance tout de suite.', 'dockerinventory') }}
            {{ __(
                'Chaque namespace qui a des charges devient une application ; chaque conteneur, une fiche de service.',
                'dockerinventory'
            ) }}
        </p>

        <div class="mb-3">
            <span class="me-2">{{ __('Dernier import', 'dockerinventory') }} :</span>
            <span class="badge bg-{{ status_colors[status] ?? 'secondary' }} text-white">{{ status_label }}</span>
            {% if item.fields['last_import_date'] %}
                <span class="ms-2 text-muted">{{ item.fields['last_import_date']|formatted_datetime }}</span>
            {% endif %}
            {% if report and report.version|default('') %}
                <span class="badge bg-azure-lt ms-2">
                    <i class="ti ti-brand-kubernetes me-1" aria-hidden="true"></i>{{ report.version }}
                </span>
            {% endif %}
        </div>

        {% if report %}
            <ul class="list-inline mb-3">
                <li class="list-inline-item">
                    <i class="ti ti-folders" aria-hidden="true"></i>
                    {{ __('Namespaces visibles', 'dockerinventory') }} :
                    <strong>{{ report.namespaces|default(0) }}</strong>
                </li>
                <li class="list-inline-item">
                    <i class="ti ti-apps" aria-hidden="true"></i>
                    {{ __('Namespaces avec des charges', 'dockerinventory') }} :
                    <strong>{{ report.stacks|default(0) }}</strong>
                    ({{ __('applications créées', 'dockerinventory') }} : {{ report.appliances_created|default(0) }})
                </li>
                <li class="list-inline-item">
                    <i class="ti ti-box" aria-hidden="true"></i>
                    {{ __('Services', 'dockerinventory') }} : <strong>{{ report.services|default(0) }}</strong>
                </li>
                <li class="list-inline-item">
                    <i class="ti ti-archive" aria-hidden="true"></i>
                    {{ __('Retirés à cet import', 'dockerinventory') }} :
                    <strong>{{ report.retired|default(0) }}</strong>
                </li>
                <li class="list-inline-item">
                    <i class="ti ti-server" aria-hidden="true"></i>
                    {{ __('Nœuds', 'dockerinventory') }} : <strong>{{ report.nodes|default(0) }}</strong>
                    ({{ __('rattachés à un ordinateur', 'dockerinventory') }} : {{ report.linked_nodes|default(0) }})
                </li>
                <li class="list-inline-item">
                    <i class="ti ti-arrows-exchange" aria-hidden="true"></i>
                    {{ __('Requêtes', 'dockerinventory') }} : <strong>{{ report.requests|default(0) }}</strong>
                </li>
            </ul>
            {% if report.warnings is defined and report.warnings is not empty %}
                <div class="alert alert-warning d-flex">
                    <i class="ti ti-alert-triangle fs-2 me-2" aria-hidden="true"></i>
                    <div>
                        <strong>{{ __('À vérifier dans le cluster', 'dockerinventory') }}</strong>
                        <ul class="mb-0">
                            {% for warning in report.warnings %}
                                <li>
                                    {% if warning.endpoint %}<code>{{ warning.endpoint }}</code> : {% endif %}
                                    {{ warning_labels[warning.code] ?? warning.code }}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endif %}
            {% if report.errors is not empty %}
                <div class="alert alert-danger d-flex">
                    <i class="ti ti-circle-x fs-2 me-2" aria-hidden="true"></i>
                    <ul class="mb-0">
                        {% for error in report.errors %}
                            <li>
                                {% if error.endpoint %}<code>{{ error.endpoint }}</code> : {% endif %}
                                {{ error_labels[error.code] ?? error.code }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        {% endif %}

        <form method="post" action="{{ item.getFormURL() }}" class="d-flex flex-wrap gap-2">
            <input type="hidden" name="id" value="{{ item.getID() }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <button type="submit" name="test" value="1" class="btn btn-outline-secondary">
                <i class="ti ti-plug-connected me-1" aria-hidden="true"></i>
                {{ __('Tester la connexion', 'dockerinventory') }}
            </button>
            <button type="submit" name="import" value="1" class="btn btn-primary">
                <i class="ti ti-download me-1" aria-hidden="true"></i>
                {{ __('Importer maintenant', 'dockerinventory') }}
            </button>
            <a href="{{ versions_url }}" class="btn btn-outline-primary">
                <i class="ti ti-tags me-1" aria-hidden="true"></i>
                {{ __('Voir les versions des images', 'dockerinventory') }}
            </a>
        </form>

        <details class="mt-3 text-muted">
            <summary>{{ __('Créer le compte de service en lecture seule', 'dockerinventory') }}</summary>
            <p class="mt-2 mb-1">
                {{ __(
                    'Appliquer le manifeste du README (kubectl apply -f), puis lire le jeton :',
                    'dockerinventory'
                ) }}
            </p>
            <pre class="mb-0"><code>kubectl -n glpi-inventaire get secret glpi-lecture-jeton \
    -o jsonpath='{.data.token}' | base64 -d
kubectl -n glpi-inventaire get secret glpi-lecture-jeton \
    -o jsonpath='{.data.ca\.crt}' | base64 -d</code></pre>
        </details>
        <details class="mt-2 text-muted">
            <summary>{{ __('Cluster sur un réseau privé (GLPI 12)', 'dockerinventory') }}</summary>
            <p class="mt-2 mb-1">
                {{ __('GLPI 12 refuse par défaut les appels vers un réseau privé.', 'dockerinventory') }}
                {{ __('Pour Kubernetes seulement, ajouter dans config/local_define.php :', 'dockerinventory') }}
            </p>
            <pre class="mb-0"><code>define('GLPI_SERVERSIDE_URL_ALLOWED_PRIVATE_NETWORKS_CONTEXTS', [
    '{{ context_class }}',
]);</code></pre>
        </details>
    </div>
</div>
