{% import '@dockerinventory/_tone.html.twig' as tone %}

{# Vulnérabilités détaillées d'une analyse importée (#73) : exploitées activement (catalogue CISA KEV,
   #84) d'abord, puis des plus graves aux moins graves, puis par probabilité d'exploitation (EPSS). #}
<details>
    <summary class="small">
        <i class="ti ti-list-details me-1" aria-hidden="true"></i>
        {{ __('Vulnérabilités détaillées (%d)', 'dockerinventory')|format(scan.findings|length) }}
    </summary>
    {% if scan.truncated %}
        <p class="small text-muted mb-1">
            {{ __('Seules les %d plus graves sont détaillées ; les compteurs portent sur toutes.', 'dockerinventory')
                |format(scan.findings|length) }}
        </p>
    {% endif %}
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>{{ __('Vulnérabilité', 'dockerinventory') }}</th>
                    <th>{{ __('Gravité', 'dockerinventory') }}</th>
                    <th>{{ __('Exploitation connue', 'dockerinventory') }}</th>
                    <th>{{ __('Paquet', 'dockerinventory') }}</th>
                    <th>{{ __('Version installée', 'dockerinventory') }}</th>
                    <th>{{ __('Corrigée en', 'dockerinventory') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for finding in scan.findings %}
                    <tr>
                        <td><code>{{ finding.id }}</code></td>
                        <td>
                            <span class="badge {{ tone.badge(finding.severity.color) }}">
                                <i class="{{ finding.severity.icon }} me-1" aria-hidden="true"></i>
                                {{- finding.severity.label -}}
                            </span>
                        </td>
                        <td>
                            {% if finding.kev %}
                                <span class="badge bg-danger text-white" title="{{ finding.kev_name }}"
                                      data-bs-toggle="tooltip">
                                    <i class="ti ti-flame me-1" aria-hidden="true"></i>
                                    {{- __('Exploitée activement', 'dockerinventory') -}}
                                </span>
                                {% if finding.ransomware %}
                                    <span class="badge bg-danger-subtle text-danger-emphasis">
                                        <i class="ti ti-lock-exclamation me-1" aria-hidden="true"></i>
                                        {{- __('Rançongiciel', 'dockerinventory') -}}
                                    </span>
                                {% endif %}
                                {% if finding.kev_due %}
                                    <div class="small text-muted">
                                        {{ __('Échéance CISA : %s', 'dockerinventory')
                                            |format(finding.kev_due|formatted_date) }}
                                    </div>
                                {% endif %}
                            {% endif %}
                            {% if finding.epss is not null %}
                                {% set epss_badge = finding.epss_high ? 'warning' : 'secondary' %}
                                <span class="badge bg-{{ epss_badge }}-subtle text-{{ epss_badge }}-emphasis"
                                      title="{{ __(
                                          'Probabilité d’exploitation dans les 30 jours (EPSS)',
                                          'dockerinventory'
                                      ) }}"
                                      data-bs-toggle="tooltip">
                                    EPSS {{ finding.epss }} %
                                </span>
                            {% endif %}
                            {% if not finding.kev and finding.epss is null %}
                                <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td>{{ finding.package }}</td>
                        <td>{{ finding.installed }}</td>
                        <td>{{ finding.fixed ?: '-' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</details>
