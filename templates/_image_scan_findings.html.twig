{% import '@dockerinventory/_tone.html.twig' as tone %}

{# Vulnérabilités détaillées d'une analyse importée (#73), des plus graves aux moins graves. #}
<details>
    <summary class="small">
        <i class="ti ti-list-details me-1" aria-hidden="true"></i>
        {{ __('Vulnérabilités détaillées (%d)', 'dockerinventory')|format(scan.findings|length) }}
    </summary>
    {% if scan.truncated %}
        <p class="small text-muted mb-1">
            {{ __('Seules les %d plus graves sont détaillées ; les compteurs portent sur toutes.', 'dockerinventory')
                |format(scan.findings|length) }}
        </p>
    {% endif %}
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>{{ __('Vulnérabilité', 'dockerinventory') }}</th>
                    <th>{{ __('Gravité', 'dockerinventory') }}</th>
                    <th>{{ __('Paquet', 'dockerinventory') }}</th>
                    <th>{{ __('Version installée', 'dockerinventory') }}</th>
                    <th>{{ __('Corrigée en', 'dockerinventory') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for finding in scan.findings %}
                    <tr>
                        <td><code>{{ finding.id }}</code></td>
                        <td>
                            <span class="badge {{ tone.badge(finding.severity.color) }}">
                                <i class="{{ finding.severity.icon }} me-1" aria-hidden="true"></i>
                                {{- finding.severity.label -}}
                            </span>
                        </td>
                        <td>{{ finding.package }}</td>
                        <td>{{ finding.installed }}</td>
                        <td>{{ finding.fixed ?: '-' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</details>
