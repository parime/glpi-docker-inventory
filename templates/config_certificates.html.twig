{# Onglet « Certificats TLS » de la page de configuration du plugin (#78) : réglages seulement (délai
   d'alerte avant l'expiration, état de la tâche automatique). Les certificats et leur lecture sur clic
   sont dans Parc > Inventaire Docker > Exposition. #}
<div class="container-fluid">
    {{ include('@dockerinventory/_page_help.html.twig', {
        page: 'certificates',
        purpose: __(
            'Être prévenu avant qu’un certificat TLS d’une route d’entrée n’expire.',
            'dockerinventory'
        ),
        expected: __(
            'Choisissez le délai d’alerte ; activez la tâche automatique pour une lecture et un rappel quotidiens.',
            'dockerinventory'
        ) ~ ' ' ~ __(
            'Certificats et lecture sur clic : Parc > Inventaire Docker > Exposition.',
            'dockerinventory'
        ),
        reference: __('Utilisation de la cryptographie (ISO 27001, mesure A.8.24).', 'dockerinventory'),
    }) }}
    {{ include('@dockerinventory/_section_nav.html.twig') }}
    <div class="card mb-3">
        <div class="card-header">
            <h2 class="card-title mb-0">
                <i class="ti ti-certificate me-2" aria-hidden="true"></i>{{ __('Certificats TLS', 'dockerinventory') }}
            </h2>
        </div>
        <div class="card-body">
            <p class="text-muted">
                {{ __(
                    'Le plugin lit le certificat présenté sur le port 443 par chaque route HTTPS (Traefik, ingress).',
                    'dockerinventory'
                ) }}
                {{ __(
                    'Seul le certificat public est lu : aucune requête, aucun identifiant, rien n’est renouvelé.',
                    'dockerinventory'
                ) }}
            </p>
            <form method="post" action="{{ page_url }}" class="row g-3 align-items-end">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <div class="col-sm-6 col-lg-4">
                    <label class="form-label" for="dockerinventory-certificate-days">
                        {{ __('Alerter avant l’expiration (jours)', 'dockerinventory') }}
                    </label>
                    <input type="number" class="form-control" id="dockerinventory-certificate-days"
                           name="warning_days" min="1" max="{{ settings.max_days }}"
                           value="{{ settings.warning_days }}">
                </div>
                <div class="col-auto">
                    <button type="submit" name="save_certificates" value="1" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-1" aria-hidden="true"></i>
                        {{- __('Enregistrer', 'dockerinventory') -}}
                    </button>
                </div>
            </form>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title mb-0">
                <i class="ti ti-clock me-2" aria-hidden="true"></i>
                {{- __('Lecture et rappel quotidiens', 'dockerinventory') -}}
            </h3>
        </div>
        <div class="card-body">
            <p class="mb-2 small text-muted">
                <i class="ti ti-clock me-1" aria-hidden="true"></i>
                {% if settings.cron_active %}
                    {{ __(
                        'Tâche automatique « certificatecheck » active : lecture et rappel une fois par jour.',
                        'dockerinventory'
                    ) }}
                {% else %}
                    {{ __(
                        'Tâche automatique « certificatecheck » désactivée : activez-la pour être prévenu à temps.',
                        'dockerinventory'
                    ) }}
                {% endif %}
                {% if settings.cron_url %}
                    <a href="{{ settings.cron_url }}" class="text-decoration-underline">
                        {{- __('Ouvrir la tâche automatique', 'dockerinventory') -}}
                    </a>
                {% endif %}
            </p>
            <p class="mb-0 small text-muted">
                <i class="ti ti-mail me-1" aria-hidden="true"></i>
                {{ __(
                    'Destinataires du rappel : Configuration > Notifications, « Certificat TLS qui expire bientôt ».',
                    'dockerinventory'
                ) }}
            </p>
        </div>
    </div>
</div>
