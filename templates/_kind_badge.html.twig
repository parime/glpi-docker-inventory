{# Nature d'un service : Swarm, Compose, conteneur autonome ou charge Kubernetes. #}
{% set kind_styles = {
    swarm: ['bg-info-subtle text-info-emphasis', 'ti-topology-star-3'],
    compose: ['bg-info-subtle text-info-emphasis', 'ti-stack-2'],
    container: ['bg-warning-subtle text-warning-emphasis', 'ti-box'],
    deployment: ['bg-info-subtle text-info-emphasis', 'ti-brand-kubernetes'],
    statefulset: ['bg-secondary-subtle text-secondary-emphasis', 'ti-database'],
    daemonset: ['bg-success-subtle text-success-emphasis', 'ti-server-2'],
    cronjob: ['bg-warning-subtle text-warning-emphasis', 'ti-clock-play'],
} %}
{% set style = kind_styles[service.kind]|default(['bg-secondary-subtle text-secondary-emphasis', 'ti-brand-docker']) %}
<span class="badge {{ style[0] }} ms-1">
    <i class="ti {{ style[1] }} me-1" aria-hidden="true"></i>{{ service.kind_label }}
</span>
