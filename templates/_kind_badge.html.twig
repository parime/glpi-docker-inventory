{# Nature d'un service : Swarm, Compose ou conteneur autonome. #}
{% set kind_styles = {
    swarm: ['bg-indigo-lt', 'ti-topology-star-3'],
    compose: ['bg-cyan-lt', 'ti-stack-2'],
    container: ['bg-orange-lt', 'ti-box'],
} %}
{% set style = kind_styles[service.kind]|default(['bg-secondary-lt', 'ti-brand-docker']) %}
<span class="badge {{ style[0] }} ms-1">
    <i class="ti {{ style[1] }} me-1" aria-hidden="true"></i>{{ service.kind_label }}
</span>
