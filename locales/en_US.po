msgstr "The Kubernetes service account token is required."

msgid "Certificat d'autorité invalide : coller le contenu PEM (-----BEGIN CERTIFICATE-----...)."
msgstr "Invalid certificate authority: paste the PEM content (-----BEGIN CERTIFICATE-----...)."

#, php-format
msgid "Import terminé (%1$s) : %2$d namespaces, %3$d applications, %4$d services, %5$d retirés, %6$d nœuds."
msgstr "Import finished (%1$s): %2$d namespaces, %3$d appliances, %4$d services, %5$d retired, %6$d nodes."

msgid "Le compte ne voit aucun namespace : vérifiez son ClusterRole (voir README)."
msgstr "The account sees no namespace: check its ClusterRole (see README)."

msgid "Lecture refusée au compte de service (403) : rien n’en a été retiré."
msgstr "Reading refused to the service account (403): nothing was retired from it."

msgid "Vérifiez son ClusterRole (voir README)."
msgstr "Check its ClusterRole (see README)."

msgid "Aucune charge trouvée alors que le dernier import en trouvait : rien n'a été retiré."
msgstr "No workload found although the last import found some: nothing was retired."

msgid "Vérifiez les droits du compte de service (voir README)."
msgstr "Check the service account rights (see README)."

msgid "Liste trop longue, lue en partie : rien n’en a été retiré."
msgstr "List too long, partly read: nothing was retired from it."

#, php-format
msgid "Connexion réussie : Kubernetes %1$s, %2$d namespace(s) visible(s) avec ce jeton."
msgstr "Connection successful: Kubernetes %1$s, %2$d namespace(s) visible with this token."

#, php-format
msgid "Lecture refusée (403) : %s. Complétez le ClusterRole (voir README)."
msgstr "Reading refused (403): %s. Complete the ClusterRole (see README)."

msgid "Jeton refusé par le cluster (401) : jeton expiré ou compte de service supprimé ?"
msgstr "Token refused by the cluster (401): expired token or deleted service account?"

msgid "Lecture refusée au compte de service (403) : vérifiez son ClusterRole (voir README)."
msgstr "Reading refused to the service account (403): check its ClusterRole (see README)."

msgid "Adresse introuvable (404) : indiquer l'adresse de l'API du cluster (port 6443 en général)."
msgstr "Address not found (404): enter the cluster API address (usually port 6443)."

msgid "Liste modifiée pendant la lecture (410) : nouvel essai au prochain import."
msgstr "List changed while being read (410): new try at the next import."

msgid "Limite de requêtes de l'API atteinte (429) : la suite est lue au prochain import."
msgstr "API request limit reached (429): the rest is read at the next import."

msgid "L'API du cluster a répondu par une erreur interne (5xx)."
msgstr "The cluster API answered with an internal error (5xx)."

msgid "Certificat du cluster non reconnu : coller le certificat d'autorité du cluster (voir README)."
msgstr "Cluster certificate not recognized: paste the cluster certificate authority (see README)."

msgid "Réponse inattendue : est-ce bien l'API d'un cluster Kubernetes ?"
msgstr "Unexpected answer: is this really the API of a Kubernetes cluster?"

msgid "Cluster injoignable (réseau, nom, délai...)."
msgstr "Cluster unreachable (network, name, timeout...)."

msgid "Import des namespaces, charges de travail et nœuds depuis Kubernetes"
msgstr "Import of namespaces, workloads and nodes from Kubernetes"

msgid "Disponible"
msgstr "Available"

msgid "Mise à jour en cours"
msgstr "Update in progress"

msgid "Dégradé"
msgstr "Degraded"

