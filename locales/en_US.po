msgstr "Cluster certificate authority"

msgid "Facultatif : contenu PEM (ca.crt) si le cluster a sa propre autorité ; vide : autorités du système."
msgstr "Optional: PEM content (ca.crt) if the cluster has its own authority; empty: system authorities."

msgid "Namespaces ignorés"
msgstr "Ignored namespaces"

msgid "Séparés par des virgules ; « * » accepté (cattle-*). Par défaut : namespaces du système."
msgstr "Comma-separated; \"*\" accepted (cattle-*). Default: system namespaces."

msgid "Namespace"
msgstr "Namespace"

#, php-format
msgid "Créée par le plugin Inventaire Docker pour le namespace Kubernetes « %1$s » (%2$s)."
msgstr "Created by the Docker Inventory plugin for the Kubernetes namespace \"%1$s\" (%2$s)."

